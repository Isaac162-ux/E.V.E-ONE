# Shared server-to-server token. Put the same value in the web app's .dev.vars.
EVE_API_TOKEN=generate-a-long-random-secret
EVE_DEFAULT_PROVIDER=gemini

# Google AI Studio. Model can be overridden to one enabled for your account.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# OpenRouter model is an exact slug from https://openrouter.ai/models.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Groq model can be changed to any model currently enabled for the account.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Optional integrations. Keep keys server-side.
SPTRANS_API_TOKEN=
GOOGLE_MAPS_API_KEY=

# Empty means no direct browser origins; the web app uses a same-origin server proxy.
EVE_CORS_ORIGINS=
